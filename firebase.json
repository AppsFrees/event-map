{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "site": "eventmaps",
    "public": ".",
    "ignore": [
      "firebase.json", "**/.*", "**/node_modules/**", "build/**", "scripts/**",
      "app.js", "README.md", "LICENSE", "firestore.rules", "firestore.indexes.json"
    ],
    "cleanUrls": false,
    "headers": [
      { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|jpg|webp|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}

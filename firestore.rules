rules_version = '2';

// Eventmaps — reglas de seguridad de Cloud Firestore
// Roles: 'user' (por defecto), 'business' (dueño de negocio) y 'admin'.
// El rol vive en /users/{uid}.role y SOLO un admin puede cambiarlo.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Utilidades ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(uid())); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(uid())); }
    function role() { return hasProfile() ? userDoc().data.role : 'guest'; }
    function isDisabled() { return hasProfile() && userDoc().data.get('disabled', false) == true; }
    function isAdmin() { return signedIn() && !isDisabled() && role() == 'admin'; }
    function emailVerified() {
      return signedIn() && !isDisabled() && (request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(data, k, max) { return !(k in data) || (data[k] is string && data[k].size() <= max); }

    // ---------- Usuarios ----------
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());

      // Alta del propio perfil: siempre como 'user'.
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['displayName','email','role','createdAt','theme','notify','lastSeenEvents'])
        && optStr(request.resource.data, 'displayName', 80);

      // El usuario puede editar sus preferencias, pero no su rol.
      allow update: if (signedIn() && uid() == userId
          && onlyChanges(['displayName','theme','notify','lastSeenEvents'])
          && optStr(request.resource.data, 'displayName', 80))
        || (isAdmin() && onlyChanges(['role','disabled'])
          && request.resource.data.role in ['user','business','admin']);

      allow delete: if isAdmin();

      // Favoritos por cuenta
      match /favorites/{businessId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }

      // Agenda ("Voy a ir") — base de las reseñas verificadas
      match /agenda/{eventId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['businessId','createdAt'])
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/events/$(eventId))
          && get(/databases/$(database)/documents/events/$(eventId)).data.businessId == request.resource.data.businessId;
      }

      // Tokens de Cloud Messaging de cada dispositivo (los usa el envío programado de GitHub Actions)
      match /pushTokens/{tokenId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['token','ua','createdAt'])
          && request.resource.data.token == tokenId
          && tokenId.size() < 400
          && optStr(request.resource.data, 'ua', 200);
      }
    }

    // ---------- Categorías ----------
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Negocios ----------
    match /businesses/{bid} {
      function isOwner() { return signedIn() && resource.data.ownerUid == uid(); }

      allow get: if resource.data.status == 'approved' || isOwner() || isAdmin();
      allow list: if resource.data.status == 'approved' || isOwner() || isAdmin();

      // Cualquier usuario con correo verificado puede solicitar alta: queda 'pending'.
      allow create: if isAdmin() || emailVerified()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.plan in ['Free','Standard','Pro']
        && request.resource.data.paused == false
        && request.resource.data.subscriptionActive == false
        && str(request.resource.data.name, 2, 60)
        && str(request.resource.data.category, 1, 40)
        && str(request.resource.data.address, 3, 200)
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 5
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','name','category','plan','address','lat','lng',
             'country','department','district','mapImage',
             'description','hours','socials','photos','promo','paused','status','subscriptionActive','subscriptionEnd',
             'createdAt','updatedAt']);

      // El dueño edita su ficha, pero NO estado, plan, suscripción ni propietario.
      allow update: if (isOwner()
          && onlyChanges(['name','category','address','lat','lng','country','department','district','mapImage','description','hours','socials','photos','promo','paused','updatedAt'])
          && str(request.resource.data.name, 2, 60)
          && str(request.resource.data.address, 3, 200)
          && optStr(request.resource.data, 'description', 4000)
          && request.resource.data.photos is list
          && request.resource.data.photos.size() <= (resource.data.plan == 'Pro' ? 5 : resource.data.plan == 'Standard' ? 3 : 1))
        || isAdmin();

      allow delete: if isAdmin() || (isOwner() && resource.data.status != 'approved');
    }

    // ---------- Eventos (requieren moderación) ----------
    match /events/{eid} {
      function evOwner() { return signedIn() && resource.data.ownerUid == uid(); }
      function bizOf(id) { return get(/databases/$(database)/documents/businesses/$(id)).data; }
      function validEvent(d) {
        return str(d.title, 2, 90)
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.endDate >= d.date
          && optStr(d, 'time', 5)
          && optStr(d, 'description', 4000);
      }

      allow get, list: if resource.data.status == 'approved' || evOwner() || isAdmin();

      // Solo el dueño de un negocio aprobado crea eventos y siempre quedan 'pending'.
      allow create: if isAdmin() || signedIn()
        && request.resource.data.ownerUid == uid()
        && bizOf(request.resource.data.businessId).ownerUid == uid()
        && bizOf(request.resource.data.businessId).status == 'approved'
        && request.resource.data.status == 'pending'
        && validEvent(request.resource.data);

      // Al editar, el evento vuelve a revisión.
      allow update: if (evOwner()
          && onlyChanges(['title','date','endDate','time','description','status','updatedAt','startAt'])
          && request.resource.data.status == 'pending'
          && validEvent(request.resource.data))
        || isAdmin();

      allow delete: if evOwner() || isAdmin();
    }

    // ---------- Reseñas (una por usuario y negocio; ID = businessId_uid) ----------
    match /reviews/{rid} {
      function agendaPath(eventId) { return /databases/$(database)/documents/users/$(uid())/agenda/$(eventId); }
      function eventDoc(eventId) { return get(/databases/$(database)/documents/events/$(eventId)).data; }
      // Verificada = el usuario marcó "Voy" a un evento del negocio y ese evento ya comenzó.
      function verifiedOk(d) {
        return d.verified == false || (
          d.eventId is string
          && exists(agendaPath(d.eventId))
          && eventDoc(d.eventId).businessId == d.businessId
          && eventDoc(d.eventId).startAt <= request.time);
      }

      allow get, list: if resource.data.status == 'visible' || (signedIn() && resource.data.uid == uid()) || isAdmin();

      allow create: if emailVerified()
        && rid == request.resource.data.businessId + '_' + uid()
        && request.resource.data.uid == uid()
        && request.resource.data.status == 'visible'
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && str(request.resource.data.text, 3, 500)
        && optStr(request.resource.data, 'displayName', 80)
        && request.resource.data.verified is bool
        && verifiedOk(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if (signedIn() && resource.data.uid == uid()
          && onlyChanges(['stars','text','updatedAt'])
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && str(request.resource.data.text, 3, 500))
        || (isAdmin() && onlyChanges(['status','moderatedAt']));

      allow delete: if isAdmin() || (signedIn() && resource.data.uid == uid());
    }

    // ---------- Fotos sin Storage (respaldo mientras el proyecto está en plan Spark) ----------
    // Imágenes comprimidas (data URL) en un documento aparte para no inflar el listado del mapa.
    match /businessPhotos/{bid} {
      function biz() { return get(/databases/$(database)/documents/businesses/$(bid)).data; }
      function limitFor(plan) { return plan == 'Pro' ? 5 : plan == 'Standard' ? 3 : 1; }
      allow read: if biz().status == 'approved' || (signedIn() && biz().ownerUid == uid()) || isAdmin();
      allow write: if (signedIn() && biz().ownerUid == uid() || isAdmin())
        && request.resource.data.keys().hasOnly(['photos','updatedAt'])
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= limitFor(biz().plan);
      allow delete: if isAdmin();
    }

    // ---------- Analítica pública por negocio (solo incrementos de 1) ----------
    match /stats/{bid} {
      function inc1(k) {
        return request.resource.data[k] == resource.data.get(k, 0) + 1;
      }
      allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/businesses/$(bid)).data.ownerUid == uid());
      allow create: if request.resource.data.keys().hasOnly(['views','routes','shares','going'])
        && request.resource.data.values().hasOnly([0, 1]);
      allow update: if onlyChanges(['views']) && inc1('views')
        || onlyChanges(['routes']) && inc1('routes')
        || onlyChanges(['shares']) && inc1('shares')
        || onlyChanges(['going']) && request.resource.data.going >= 0
           && (request.resource.data.going == resource.data.get('going', 0) + 1
               || request.resource.data.going == resource.data.get('going', 0) - 1);
    }

    // ---------- Pagos y Suscripciones (Yape, Plin, PayPal, Stripe) ----------
    match /payments/{paymentId} {
      function isPaymentOwner() { return signedIn() && resource.data.ownerUid == uid(); }
      function ownsBusiness(id) { return exists(/databases/$(database)/documents/businesses/$(id))
        && get(/databases/$(database)/documents/businesses/$(id)).data.ownerUid == uid(); }
      allow get, list: if isPaymentOwner() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && ownsBusiness(request.resource.data.businessId)
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.plan in ['Standard','Pro']
        && request.resource.data.method in ['yape','plin','paypal','stripe']
        && request.resource.data.currency in ['PEN','USD']
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000
        && str(request.resource.data.operationCode, 3, 40)
        && str(request.resource.data.voucher, 20, 600000)
        && request.resource.data.keys().hasOnly(['ownerUid','ownerEmail','businessId','businessName','plan','amount','currency','method','operationCode','voucher','status','createdAt','updatedAt']);
      allow update, delete: if isAdmin();
    }

    // Solicitudes de eliminación: el borrado definitivo lo realiza un admin
    // desde un proceso documentado, incluyendo datos asociados y Auth.
    match /deletionRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','status','createdAt']);
      allow get, list: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /settings/payments {
      function valid(d) {
        return d.keys().hasAll(['yapeEnabled','yapeNumber','yapeHolder','plinEnabled','plinNumber','plinHolder','paypalEnabled','paypalEmail','paypalUrl','updatedAt'])
          && d.keys().hasOnly(['yapeEnabled','yapeNumber','yapeHolder','plinEnabled','plinNumber','plinHolder','paypalEnabled','paypalEmail','paypalUrl','updatedAt'])
          && d.yapeEnabled is bool && d.plinEnabled is bool && d.paypalEnabled is bool
          && str(d.yapeNumber,0,9) && str(d.plinNumber,0,9) && str(d.yapeHolder,0,100) && str(d.plinHolder,0,100)
          && str(d.paypalEmail,0,254) && str(d.paypalUrl,0,500)
          && (!d.yapeEnabled || (d.yapeNumber.matches('^9[0-9]{8}$') && d.yapeHolder.size()>0))
          && (!d.plinEnabled || (d.plinNumber.matches('^9[0-9]{8}$') && d.plinHolder.size()>0))
          && (d.paypalEmail=='' || d.paypalEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$'))
          && (d.paypalUrl=='' || d.paypalUrl.matches('^https://(www[.])?paypal[.]me/[^ @]*$') || d.paypalUrl.matches('^https://(www[.])?paypal[.]com/[^ @]*$'))
          && (!d.paypalEnabled || d.paypalEmail.size()>0 || d.paypalUrl.size()>0)
          && d.updatedAt == request.time;
      }
      allow get: if true;
      allow create, update: if isAdmin() && valid(request.resource.data);
      allow delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
